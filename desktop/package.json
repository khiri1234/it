{
  "name": "the-h-business-management-desktop",
  "productName": "THE H BUSINESS MANAGEMENT",
  "version": "1.0.0",
  "description": "THE H BUSINESS MANAGEMENT, packaged as a macOS desktop app",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy-app": "node scripts/copy-app.js",
    "start": "npm run copy-app && electron .",
    "dist": "npm run copy-app && electron-builder --mac",
    "dist:dir": "npm run copy-app && electron-builder --mac dir",
    "dist:mas": "npm run copy-app && electron-builder --mac mas"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.thehitsolutions.businessmanagement",
    "productName": "THE H BUSINESS MANAGEMENT",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Used to scan barcodes and QR codes for inventory lookups."
      }
    },
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist"
    },
    "dmg": {
      "title": "THE H BUSINESS MANAGEMENT"
    }
  }
}
